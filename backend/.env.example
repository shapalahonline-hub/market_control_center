# ─── Market Control Center — backend config ───────────────────────────────
# Copy to .env and fill in. Nothing here is committed (.env is gitignored).

# Database — SQLite locally; swap a Postgres URL in prod (Railway).
DATABASE_URL=sqlite:///./mcc.db

# Single-user auth (this is a private, one-operator tool)
APP_PASSWORD=changeme
JWT_SECRET=dev-secret-change-me

# Encryption-at-rest for stored connector tokens (Fernet key, base64 32 bytes).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ─── Claude (content angles / hooks / captions) — REAL, ship day one ───────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# ─── Meta Ads (insights READ + boost WRITE) ────────────────────────────────
# One non-expiring System User token (Business Settings → System Users),
# assigned your Ad Account + Page + Instagram account.
META_SYSTEM_USER_TOKEN=
META_AD_ACCOUNT_ID=          # without the act_ prefix, e.g. 1234567890
META_PAGE_ID=
META_IG_USER_ID=
META_GRAPH_VERSION=v23.0

# ─── Higgsfield (video generation) — optional; manual upload is the fallback ─
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=

# Public base URL of THIS app (used to build /r/{slug} share links)
PUBLIC_BASE_URL=http://localhost:8000

# Timezone for rendering (data stored UTC)
TIMEZONE=Asia/Almaty
